---
import { getCollection } from 'astro:content';

const alerts = await getCollection('alert');
const alert = alerts[0]?.data;
---

{
  alert?.enabled && alert.message && (
    <div class="relative z-40 bg-gradient-to-r from-gold to-gold-bright px-4 py-3 text-center text-sm font-bold text-ink sm:text-base" role="alert">
      <span>{alert.message}</span>
      {alert.linkUrl && alert.linkText && (
        <a href={alert.linkUrl} class="ml-2 underline decoration-2 underline-offset-2 hover:opacity-80">
          {alert.linkText}
        </a>
      )}
    </div>
  )
}
