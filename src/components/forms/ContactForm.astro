<form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/thank-you?form=contact" class="grid gap-4">
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

  <div class="grid gap-1">
    <label for="c-name" class="text-sm font-semibold">Name</label>
    <input id="c-name" name="name" type="text" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
  </div>
  <div class="grid gap-1">
    <label for="c-email" class="text-sm font-semibold">Email</label>
    <input id="c-email" name="email" type="email" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
  </div>
  <div class="grid gap-1">
    <label for="c-subject" class="text-sm font-semibold">Subject</label>
    <input id="c-subject" name="subject" type="text" class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
  </div>
  <div class="grid gap-1">
    <label for="c-message" class="text-sm font-semibold">Message</label>
    <textarea id="c-message" name="message" rows="5" required class="rounded-xl border-2 border-ink/15 px-4 py-3"></textarea>
  </div>
  <button type="submit" class="btn-gold w-full sm:w-fit">Send Message</button>
</form>
