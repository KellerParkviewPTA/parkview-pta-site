<form name="volunteer-interest" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/thank-you?form=volunteer-interest" class="grid gap-4">
  <input type="hidden" name="form-name" value="volunteer-interest" />
  <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-1">
      <label for="vi-name" class="text-sm font-semibold">Name</label>
      <input id="vi-name" name="name" type="text" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
    </div>
    <div class="grid gap-1">
      <label for="vi-email" class="text-sm font-semibold">Email</label>
      <input id="vi-email" name="email" type="email" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
    </div>
  </div>
  <div class="grid gap-1">
    <label for="vi-interests" class="text-sm font-semibold">What are you interested in helping with?</label>
    <textarea id="vi-interests" name="interests" rows="3" placeholder="e.g. Book Fair, Field Day, Room Parent, Fundraising..." class="rounded-xl border-2 border-ink/15 px-4 py-3"></textarea>
  </div>
  <div class="grid gap-1">
    <label for="vi-availability" class="text-sm font-semibold">General availability</label>
    <input id="vi-availability" name="availability" type="text" placeholder="e.g. Weekday mornings" class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
  </div>
  <button type="submit" class="btn-gold w-full sm:w-fit">Submit Interest</button>
</form>
