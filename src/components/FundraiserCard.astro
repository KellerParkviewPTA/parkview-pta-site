---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  fundraiser: CollectionEntry<'fundraisers'>;
}
const { fundraiser } = Astro.props;
const { data } = fundraiser;
const goal = data.goalAmount ?? 0;
const raised = data.raisedAmount ?? 0;
const pct = goal > 0 ? Math.min(100, Math.round((raised / goal) * 100)) : 0;
const fmt = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<div class="card flex flex-col gap-4 !p-0 overflow-hidden">
  {data.image && (
    <Image src={data.image} alt={data.title} width={500} height={220} class="h-44 w-full object-cover" />
  )}
  <div class="flex flex-col gap-3 p-6">
    <h3 class="font-display text-xl font-bold text-paper">{data.title}</h3>

    {data.status === 'active' ? (
      <>
        <div class="h-3 w-full overflow-hidden rounded-full bg-ink-softer">
          <div class="h-full rounded-full bg-gradient-to-r from-gold to-gold-bright transition-all" style={`width: ${pct}%`}></div>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-bold text-gold-bright">{fmt(raised)} raised</span>
          <span class="text-paper/60">of {fmt(goal)} goal ({pct}%)</span>
        </div>
        {data.endDate && (
          <p class="text-xs text-paper/50">Ends {data.endDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}</p>
        )}
        {data.donateUrl && <a href={data.donateUrl} class="btn-gold mt-2">Donate / Participate</a>}
      </>
    ) : (
      <>
        <p class="text-sm text-paper/60">
          Raised <span class="font-bold text-gold-bright">{fmt(raised)}</span>
          {goal ? ` of a ${fmt(goal)} goal` : ''}.
        </p>
        {data.fundedDescription && <p class="text-sm text-paper/70">{data.fundedDescription}</p>}
      </>
    )}
  </div>
</div>
