---
import siteConfig from '../site.config';
import { primaryNav, moreNav, footerLegalNav } from '../nav.config';

const year = new Date().getFullYear();
const quickLinks = [...primaryNav.slice(1), ...moreNav.slice(0, 5)];
---

<footer class="relative overflow-hidden border-t border-gold/15 bg-ink text-paper">
  <div class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>
  <div class="section relative grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <a href="/" class="mb-3 flex items-center gap-2">
        <img
          src={siteConfig.logoPath}
          alt={siteConfig.logoAltText}
          class="h-10 w-10 rounded-full border-2 border-gold/40 object-cover"
          width="40"
          height="40"
        />
        <span class="font-display text-lg font-semibold">{siteConfig.ptaName}</span>
      </a>
      <p class="text-sm text-paper/70">{siteConfig.schoolName} · {siteConfig.district}</p>
      <address class="mt-3 space-y-1 text-sm text-paper/70 not-italic">
        <p>{siteConfig.address.line1}</p>
        <p>{siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}</p>
        <p><a href={`mailto:${siteConfig.email}`} class="hover:text-gold-bright">{siteConfig.email}</a></p>
        <p><a href={`tel:${siteConfig.phone.replace(/[^\d+]/g, '')}`} class="hover:text-gold-bright">{siteConfig.phone}</a></p>
      </address>
      <div class="mt-4 flex gap-3">
        <a href={siteConfig.social.facebook} class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 hover:bg-gold/10" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-gold"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.6 1.6-1.6h1.7V4.2C16.5 4.1 15.4 4 14.2 4c-2.6 0-4.4 1.6-4.4 4.5v2.3H7.1v3.2h2.7v8h3.7Z"/></svg>
        </a>
        <a href={siteConfig.social.instagram} class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 hover:bg-gold/10" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 text-gold"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h2 class="mb-3 font-display text-sm font-bold tracking-wide text-gold-bright uppercase">Quick Links</h2>
      <ul class="space-y-2 text-sm text-paper/80">
        {quickLinks.map((l) => <li><a href={l.href} class="hover:text-gold-bright">{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-display text-sm font-bold tracking-wide text-gold-bright uppercase">Take Action</h2>
      <ul class="space-y-2 text-sm text-paper/80">
        <li><a href="/join" class="hover:text-gold-bright">Join the PTA</a></li>
        <li><a href="/sponsorship" class="hover:text-gold-bright">Become a Sponsor</a></li>
        <li><a href="/volunteer" class="hover:text-gold-bright">Volunteer</a></li>
        <li><a href={siteConfig.links.storeUrl} class="hover:text-gold-bright">Spirit Shop</a></li>
        <li><a href="/fundraising" class="hover:text-gold-bright">Donate</a></li>
        <li><a href="/contact" class="hover:text-gold-bright">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-gold/10">
    <div class="section flex flex-col items-center justify-between gap-3 py-6 text-xs text-paper/60 sm:flex-row">
      <p>© {year} {siteConfig.ptaName}. All rights reserved.</p>
      <div class="flex gap-4">
        {footerLegalNav.map((l) => <a href={l.href} class="hover:text-gold-bright">{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>
