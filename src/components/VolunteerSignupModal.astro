<div
  id="volunteer-modal"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-ink/80 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="volunteer-modal-title"
>
  <div class="reading-panel w-full max-w-lg">
    <div class="mb-4 flex items-start justify-between gap-4">
      <h2 id="volunteer-modal-title" class="font-display text-xl font-bold">
        Sign up: <span id="volunteer-modal-opportunity" class="text-gold">this opportunity</span>
      </h2>
      <button id="volunteer-modal-close" type="button" class="shrink-0 rounded-full border-2 border-ink/20 px-3 py-1 text-sm font-bold hover:bg-ink/5" aria-label="Close">✕</button>
    </div>

    <form name="volunteer-signup" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/thank-you?form=volunteer" class="grid gap-4">
      <input type="hidden" name="form-name" value="volunteer-signup" />
      <input type="hidden" name="opportunity" id="volunteer-modal-opportunity-input" />
      <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="grid gap-1">
        <label for="v-name" class="text-sm font-semibold">Name</label>
        <input id="v-name" name="name" type="text" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="grid gap-1">
          <label for="v-email" class="text-sm font-semibold">Email</label>
          <input id="v-email" name="email" type="email" required class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
        </div>
        <div class="grid gap-1">
          <label for="v-phone" class="text-sm font-semibold">Phone</label>
          <input id="v-phone" name="phone" type="tel" class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
        </div>
      </div>
      <div class="grid gap-1">
        <label for="v-count" class="text-sm font-semibold">Number of volunteers</label>
        <input id="v-count" name="volunteer_count" type="number" min="1" value="1" class="min-h-12 rounded-xl border-2 border-ink/15 px-4" />
      </div>
      <div class="grid gap-1">
        <label for="v-notes" class="text-sm font-semibold">Notes (optional)</label>
        <textarea id="v-notes" name="notes" rows="3" class="rounded-xl border-2 border-ink/15 px-4 py-2"></textarea>
      </div>
      <button type="submit" class="btn-gold w-full">Confirm Sign Up</button>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('volunteer-modal');
  const title = document.getElementById('volunteer-modal-opportunity');
  const input = document.getElementById('volunteer-modal-opportunity-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('volunteer-modal-close');

  document.querySelectorAll('.volunteer-signup-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const t = (btn as HTMLElement).dataset.title ?? '';
      if (title) title.textContent = t;
      if (input) input.value = t;
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    });
  });

  function close() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
