---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import siteConfig from '../site.config';
import { getCollection } from 'astro:content';

const faqs = (await getCollection('faqs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));
---

<Layout title="Contact Us" description="Get in touch with the Parkview Elementary PTA.">
  <PageHero eyebrow="We'd Love to Hear From You" title="Contact Us" />

  <section class="section !pt-0 grid gap-10 lg:grid-cols-2">
    <div class="reading-panel">
      <h2 class="mb-6 font-display text-2xl font-bold">Send a Message</h2>
      <ContactForm />
    </div>

    <div class="flex flex-col gap-6">
      <div class="card">
        <h2 class="mb-3 font-display text-xl font-bold text-paper">Contact Info</h2>
        <p class="text-paper/70">{siteConfig.schoolName}</p>
        <p class="text-paper/70">{siteConfig.address.line1}</p>
        <p class="text-paper/70">{siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}</p>
        <p class="mt-2"><a href={`mailto:${siteConfig.email}`} class="font-bold text-gold-bright hover:underline">{siteConfig.email}</a></p>
        <p><a href={`tel:${siteConfig.phone.replace(/[^\d+]/g, '')}`} class="font-bold text-gold-bright hover:underline">{siteConfig.phone}</a></p>
        <div class="mt-4 flex gap-3">
          <a href={siteConfig.social.facebook} class="font-bold text-gold hover:underline">Facebook</a>
          <a href={siteConfig.social.instagram} class="font-bold text-gold hover:underline">Instagram</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-gold/20">
        <iframe
          src={siteConfig.links.googleMapsEmbedSrc}
          width="100%"
          height="280"
          style="border:0;"
          loading="lazy"
          title="Map to Parkview Elementary"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section !pt-0">
    <h2 class="mb-6 text-center font-display text-2xl font-bold text-paper">Frequently Asked Questions</h2>
    <div class="mx-auto max-w-2xl">
      <FaqAccordion items={faqs} />
    </div>
  </section>
</Layout>
