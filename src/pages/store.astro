---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import siteConfig from '../site.config';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import storeItemDefault from '../assets/placeholders/store-item.svg';

const items = await getCollection('store-items');
const showBuiltInGrid = siteConfig.features.builtInStoreGrid;
---

<Layout title="Spirit Shop" description="Shop official Parkview Elementary PTA spirit wear.">
  <PageHero eyebrow="Spirit Shop" title="Gear Up in Black & Gold" subtitle="Every purchase supports Parkview PTA programs." />

  <section class="section !pt-0 text-center">
    <div class="reading-panel mx-auto max-w-2xl">
      <h2 class="font-display text-2xl font-bold">Shop the Official Spirit Store</h2>
      <a href={siteConfig.links.storeUrl} target="_blank" rel="noopener" class="btn-gold mx-auto mt-5">
        Visit the Spirit Shop →
      </a>
    </div>
  </section>

  {
    showBuiltInGrid && (
      <section class="section !pt-0">
        <h2 class="mb-8 text-center font-display text-2xl font-bold text-paper">All Spirit Wear</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {items.map((item) => (
            <a href={item.data.url || siteConfig.links.storeUrl} class="card !p-0 overflow-hidden">
              <Image src={item.data.image ?? storeItemDefault} alt={item.data.name} width={300} height={300} class="h-48 w-full object-cover" />
              <div class="p-5">
                <h3 class="font-display font-bold text-paper">{item.data.name}</h3>
                {item.data.price && <p class="mt-1 font-bold text-gold-bright">{item.data.price}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Layout>
