---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const announcements = await getCollection('announcements');
  return announcements.map((a) => ({ params: { slug: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateStr = entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout title={entry.data.title} description={entry.data.excerpt}>
  <section class="section">
    <div class="reading-panel mx-auto max-w-2xl">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        {entry.data.pinned && <span class="badge bg-gold/20 text-gold-bright">📌 Pinned</span>}
        {entry.data.urgent && <span class="badge bg-red-500/20 text-red-500">Urgent</span>}
        <time class="text-sm text-ink/50">{dateStr}</time>
      </div>
      <h1 class="mb-6 font-display text-3xl font-bold">{entry.data.title}</h1>
      <div class="prose prose-headings:font-display max-w-none">
        <Content />
      </div>
      <a href="/news" class="mt-8 inline-block font-bold text-gold hover:underline">← Back to all announcements</a>
    </div>
  </section>
</Layout>
