---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import siteConfig from '../site.config';
import { getCollection } from 'astro:content';

const spiritNights = (await getCollection('spirit-nights')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<Layout title="Spirit Wear & Spirit Nights" description="Parkview Elementary spirit wear and restaurant spirit nights.">
  <PageHero eyebrow="Show Your Spirit" title="Spirit Wear & Spirit Nights" subtitle="Rock your black & gold and support Parkview at these local restaurants." />

  <section class="section !pt-0 text-center">
    <a href={siteConfig.links.storeUrl} class="btn-gold">Shop Spirit Wear</a>
  </section>

  <section class="section !pt-0">
    <h2 class="mb-8 text-center font-display text-2xl font-bold text-paper">Upcoming Spirit Nights</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        spiritNights.map((night) => (
          <div class="card">
            <p class="badge mb-3">{night.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}</p>
            <h3 class="font-display text-lg font-bold text-paper">{night.data.restaurantName}</h3>
            {night.data.details && <p class="mt-2 text-sm text-paper/60">{night.data.details}</p>}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
