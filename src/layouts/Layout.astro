---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UrgentBanner from '../components/UrgentBanner.astro';
import siteConfig from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description = `${siteConfig.ptaName}, supporting ${siteConfig.schoolName} students, teachers, and families in ${siteConfig.city}.`,
  image = '/images/parkview-outside.jpg',
  noIndex = false,
} = Astro.props;

const pageTitle = title === siteConfig.ptaName ? title : `${title} | ${siteConfig.ptaName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteConfig.ptaName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content={siteConfig.colors.black} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme preference: applied before paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('pta-theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Netlify Identity: lets clicking an /admin invite or password-reset
         email link (which lands here on the homepage) pop open the login
         widget automatically, then send the user on to /admin. -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>

    <!-- Analytics (off by default — enable in src/site.config.ts) -->
    {
      siteConfig.analytics.provider === 'plausible' && siteConfig.analytics.plausibleDomain && (
        <script
          defer
          data-domain={siteConfig.analytics.plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
    {
      siteConfig.analytics.provider === 'google' && siteConfig.analytics.googleAnalyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analytics.googleAnalyticsId}`}
          />
          <script is:inline define:vars={{ gaId: siteConfig.analytics.googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col font-body">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <UrgentBanner />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
